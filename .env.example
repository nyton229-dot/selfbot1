VK_USER_TOKEN=your_user_token_here
VK_USER_ID=your_user_id_here
BOT_DEBUG=0
# For Android/Pydroid set to 0 to reduce background crashes:
# BOT_ENABLE_COVER_UPDATER=0
# Optional explicit env file selection:
# BOT_ENV_FILE=mobile.env
# Optional local Ollama AI:
# OLLAMA_MODEL=mistral:latest
# OLLAMA_URL=http://127.0.0.1:11434/api/generate
# OLLAMA_CHAT_URL=http://127.0.0.1:11434/api/chat
# OLLAMA_VISION_MODEL=llava:latest
# OLLAMA_VISION_NUM_CTX=1024
# OLLAMA_VISION_NUM_PREDICT=160
# OLLAMA_VISION_TEMPERATURE=0.2
# OLLAMA_SYSTEM_PROMPT=Ты помощник по имени Артем. Отвечай кратко и по делу на русском языке.
# Если OLLAMA_SYSTEM_PROMPT не задан, бот использует промпт из команды /промт (файл ollama_prompt.txt)
# Optional cloud provider (BotHub, OpenAI-compatible):
# AI_PROVIDER=bothub
# BOTHUB_API_KEY=your_bothub_api_key_here
# BOTHUB_BASE_URL=https://openai.bothub.chat/v1
# BOTHUB_MODEL=free
# BOTHUB_SYSTEM_PROMPT=Ты Артем. Общайся дерзко, коротко и по делу.
# BOTHUB_MEDIA_SYSTEM_PROMPT=Для фото/видео отвечай колко и коротко, без двоеточий и скобок.
# BOTHUB_TEMPERATURE=0.8
# BOTHUB_MAX_TOKENS=180
# BOTHUB_TIMEOUT_SEC=30
# BOTHUB_TEXT_RETRIES=1
# BOTHUB_RETRY_DELAY_SEC=0.25
# BOTHUB_TOP_P=0.95
# BOTHUB_PRESENCE_PENALTY=0.7
# BOTHUB_FREQUENCY_PENALTY=0.5
# BOTHUB_VISION_MODEL=gemini-3.1-flash-image-preview
# BOTHUB_VISION_FALLBACK_MODEL=free
# BOTHUB_VIDEO_MODEL=gemini-3.1-flash-image-preview
# BOTHUB_VISION_RETRIES=3
# BOTHUB_VISION_TOP_P=0.95
# BOTHUB_VISION_PRESENCE_PENALTY=0.4
# BOTHUB_VISION_FREQUENCY_PENALTY=0.3
# BOTHUB_IMAGE_MODEL=gemini-3.1-flash-image-preview
# BOTHUB_IMAGE_FALLBACK_MODEL=gemini-3.1-flash-image-preview
# BOTHUB_IMAGE_SIZE=1024x1024
# BOTHUB_IMAGE_RETRIES=3
# BOTHUB_IMAGE_TIMEOUT_SEC=90
# BOTHUB_VISION_TIMEOUT_SEC=90
# Optional random background API for /цитата:
# QUOTE_USE_FREE_API=1
# QUOTE_BG_API_URL=https://picsum.photos/1280/720
# QUOTE_BG_API_FALLBACK_URLS=https://loremflickr.com/1280/720,https://picsum.photos/seed/vkbot/1280/720
# Optional background image path:
# COVER_BG_PATH=C:\path\to\your\background.png
# Optional free background API (no key example: Picsum):
# COVER_USE_FREE_API=1
# COVER_FREE_API_URL=https://picsum.photos/1920/768
# COVER_FREE_API_FALLBACK_URLS=https://loremflickr.com/1920/768,https://picsum.photos/seed/vkcover/1920/768
# Optional custom font path:
# COVER_FONT_PATH=C:\path\to\your\font.ttf
# Optional SSL troubleshooting:
# VK_CA_FILE=C:\path\to\corporate-ca.pem
# VK_SSL_NO_VERIFY=1
